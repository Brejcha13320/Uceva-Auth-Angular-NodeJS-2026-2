generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id        String   @id @unique @default(uuid())
  nombre    String
  password  String
  email     String   @unique
  rol       RolUser  @default(ESTUDIANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RolUser {
  ESTUDIANTE
  DOCENTE
  ADMIN
}